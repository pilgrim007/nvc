# Zone test.nvc.ee only. No production deployment is configured.
DirectoryIndex index.html
Options -Indexes
RewriteEngine On
RewriteCond %{HTTP_HOST} ^test\.nvc\.ee$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://test.nvc.ee%{REQUEST_URI} [R=308,L,NE]
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
<FilesMatch "^(\.|README|DEPLOY|preview-server|.*\.(md|json|ya?ml|zip|log))">
    Require all denied
</FilesMatch>
